# Server
HOST=0.0.0.0
PORT=8000

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# LLM dự phòng OpenAI-compatible (OrcaRouter/OpenRouter/Groq/Ollama...)
#   LLM_PROVIDER: auto = Gemini trước, lỗi thì rơi sang endpoint này
#                 gemini | openai = ép cứng một provider
# Chú ý: bước QA gửi ẢNH — qwen3.8-27b là model text, QA sẽ không dùng được
# nhánh này (planner/expansion/ReAct thì được); muốn thay cả QA chọn model vision.
# LLM_PROVIDER=auto
# OPENAI_BASE_URL=https://monitored-wildlife-scout-foam.trycloudflare.com/v1
# OPENAI_API_KEY=aic-93PYu_S5sFiSuqYD0qXEI6-25s_fcxfy
# OPENAI_MODEL=aic-qwen-vl
# OPENAI_QA_MODEL=aic-qwen-vl

# --- MẪU: dùng OpenRouter thay cho endpoint tự dựng ---------------------------
# Bỏ comment khối dưới VÀ comment 4 dòng OPENAI_* ở trên (đọc dòng cuối thắng,
# nhưng để hai bộ cùng bật thì sau này không ai biết bộ nào đang chạy).
#
# Base URL PHẢI có /api/v1 — domain trần trả 404 và code coi như provider chết.
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_API_KEY=sk-or-v1-...
#
# Tên model lấy NGUYÊN DẠNG từ trang model của OpenRouter ("nhà-cung-cấp/tên"
# và hậu tố ":free" nếu là bản miễn phí). Sai một ký tự = 400, không phải 404.
# OPENAI_MODEL=qwen/qwen3-vl-30b-a3b-instruct:free
#
# QA gửi ẢNH (data URL) -> model ở đây BẮT BUỘC nhận input image; xem mục
# "Input modalities" trên trang model. Model text-thuần chỉ hỏng ĐÚNG bước QA,
# planner/expansion/ReAct vẫn chạy — nên lỗi rất dễ bị bỏ sót.
# OPENAI_QA_MODEL=qwen/qwen3-vl-30b-a3b-instruct:free
#
# Rỗng = dùng OPENAI_MODEL. Đặt riêng khi muốn model suy luận tốt hơn cho ReAct.
# OPENAI_REACT_MODEL=
#
# LLM_PROVIDER=openai_first   # OpenRouter chạy CHÍNH, Gemini chỉ đỡ khi nó hỏng
#
# TIỀN: mỗi câu /agent/qa gửi tới AGENT_MAX_QA_FRAMES ảnh keyframe NGUYÊN KÍCH
# THƯỚC. Với model trả phí thì đây là bước đắt nhất trong hệ — hạ xuống 4-6
# trước khi chuyển QA sang model tính tiền.
# AGENT_MAX_QA_FRAMES=6

# Cho phép dán key Gemini mới từ Cài đặt trên giao diện (POST /agent/llm_key)
# khi key cũ cạn quota giữa buổi thi — key chỉ nằm trong RAM, restart là quay về
# file này. Endpoint không bao giờ TRẢ key (chỉ 4 ký tự cuối), nhưng ai vào được
# backend cũng ghi đè được key: đặt false nếu tunnel để công khai.
ALLOW_RUNTIME_LLM_KEY=true

# Public URL prefix used to build frame_url / video_url in responses
PUBLIC_BASE_URL=http://localhost:8000

# CORS — comma separated origins
# CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:3000
CORS_ORIGINS=*

# Data paths
# MEDIA_DIR=./media
DATA_DIR=./data


# kNN expansion (knn_metaclip2.json đã build): đo bật/tắt trên cả search thuần
# lẫn agent đều -1 @1, không thêm gì ở mức nào — footage HTV phát lại nhiều
# lần nên "hàng xóm cosine" hay là bản sao cảnh đúng nằm trong video SAI.
# Muốn thử lại: nâng KNN_SIM_THRESHOLD 0.8+ rồi build lại knn.
GRAPH_KNN_WEIGHT=0

# --- HuggingFace Hub ---
# Token KHÔNG làm băng thông nhanh hơn — nó cho quyền tải repo gated và hạn mức
# request cao hơn (trên Colab hàng nghìn notebook dùng chung IP, request ẩn danh
# bị siết trước và hay đứt giữa chừng). Lấy ở https://huggingface.co/settings/tokens
HF_TOKEN=
# Thư mục cache weight. Trên Colab trỏ vào Drive để KHÔNG tải lại mỗi session —
# đây mới là thứ tiết kiệm nhiều nhất (~7GB weight).
# HF_HOME=/content/drive/MyDrive/hf_cache
HF_HOME=
# Downloader Rust đa luồng (repo chưa lên Xet). false nếu mạng chập chờn.
HF_ENABLE_TRANSFER=true
HF_DOWNLOAD_TIMEOUT=60

# Thiết bị encode query: auto | cuda | cpu
#   cuda = chạy GPU (nhanh; GTX 1650 4GB chỉ đủ ở fp16)
#   cpu  = chạy CPU (chậm hơn nhưng luôn chạy, dùng fp32)
EMBED_DEVICE=auto

# Độ chính xác: auto | fp16 | fp32
#   auto = fp16 trên cuda, fp32 trên cpu
#   fp32 trên cuda KHÔNG vừa GTX 1650 (4GB) -> sẽ OOM
EMBED_DTYPE=fp16

# --- Tìm kiếm OCR/ASR/Caption (hybrid semantic + exact) ---
# Model embedding text cho semantic search (phải khớp model lúc build index step 07).
# Đặt rỗng hoặc 'none' để TẮT semantic (vd: GPU thiếu VRAM) -> tự về fuzzy/exact.
TEXT_EMBED_MODEL=intfloat/multilingual-e5-base
# Caption (Qwen2.5-VL, kaggle step 9) — cần data/captions/caption_data.json +
# caption_text.index; thiếu file thì /search_caption trả 503, kênh agent tự bỏ qua.
# CAPTION_SEM_WEIGHT=1.0
# CAPTION_EXACT_BONUS=0.25
# EMBED_DEVICE=cpu # dùng khi thiếu VRAM

# Khi semantic KHÔNG khả dụng (thiếu sentence-transformers hoặc chưa build index):
#   exact = khớp chuỗi con chính xác (mặc định cũ)
#   fuzzy = khớp gần đúng (rapidfuzz) — chịu được sai chính tả / lỗi OCR-ASR
TEXT_FALLBACK_MODE=fuzzy
# Ngưỡng điểm fuzzy (0..1); cao hơn = chặt hơn, ít kết quả nhưng sát hơn
FUZZY_THRESHOLD=0.6





OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=
OPENAI_MODEL=openai/gpt-5.6-luna
OPENAI_QA_MODEL=openai/gpt-5.6-luna
LLM_PROVIDER=openai_first 